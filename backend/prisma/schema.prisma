generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("MODERATOR")
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  mobileNumber String    @unique
  totalTrips   Int       @default(0)
  totalSpent   Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
}

model Trip {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  description   String
  destination   String
  coverImage    String
  images        String     // Comma separated
  videoUrl      String?
  trailerUrl    String?
  startDate     DateTime
  endDate       DateTime
  price         Float
  partialPaymentEnabled Boolean   @default(false)
  partialPaymentAmount Float?
  originalPrice Float?
  totalSeats    Int
  availableSeats Int
  itinerary     String     // JSON string
  pickupPoints  String     // JSON string
  included      String     // Comma separated
  excluded      String     // Comma separated
  difficulty    String     @default("Easy")
  category      String     @default("Adventure")
  featured      Boolean    @default(false)
  status        String     @default("UPCOMING")
  latitude      Float?
  longitude     Float?
  currentLat    Float?
  currentLng    Float?
  isLiveTracking Boolean    @default(false)
  mapRoute      String?    // JSON string
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  bookings     Booking[]
  reviews      Review[]
  chatMessages ChatMessage[]

  @@index([status])
  @@index([featured])
  @@index([destination])
}

model Booking {
  id               String        @id @default(cuid())
  tripId           String
  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelerName     String
  email            String?
  phone            String
  age              Int?
  gender           String?
  emergencyName    String?
  emergencyPhone   String?
  idProofUrl       String?
  seatCount        Int           @default(1)
  specialRequests  String?
  status           String        @default("PENDING")
  totalAmount      Float
  paidAmount       Float         @default(0.0)
  paymentStatus    String        @default("PENDING_PAYMENT")
  bookingRef       String        @unique
  paymentScreenshot String?
  isManualPayment  Boolean       @default(false)
  pickupPoint      String?
  adminNotes       String?
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payment Payment?
  paymentHistory PaymentHistory[]
  notifications NotificationLog[]

  @@index([tripId])
  @@index([email])
  @@index([bookingRef])
  @@index([userId])
}

model Payment {
  id                 String        @id @default(cuid())
  bookingId          String        @unique
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId    String        @unique
  razorpayPaymentId  String?
  razorpaySignature  String?
  amount             Float
  currency           String        @default("INR")
  status             String        @default("CREATED")
  method             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([razorpayOrderId])
}

model PaymentHistory {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime @default(now())
  method      String   @default("MANUAL")
  screenshot  String?
  status      String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
}

model Review {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userName  String
  userEmail String
  rating    Int
  comment   String
  avatar    String?
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tripId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  tripId      String
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderName  String
  senderEmail String
  content     String
  type        String      @default("TEXT")
  fileUrl     String?
  fileName    String?
  pollData    String?     // JSON string
  pinned      Boolean     @default(false)
  deleted     Boolean     @default(false)
  isEdited    Boolean     @default(false)
  replyToId   String?
  createdAt   DateTime    @default(now())

  @@index([tripId])
  @@index([createdAt])
}

model Blog {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String
  author     String
  coverImage String
  tags       String   // Comma separated
  published  Boolean  @default(true)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VoteDestination {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  suggestedBy String
  voteCount   Int      @default(0)
  createdAt   DateTime @default(now())

  votes    Vote[]
  comments VoteComment[]
}

model Vote {
  id            String          @id @default(cuid())
  destinationId String
  destination   VoteDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  voterEmail    String
  createdAt     DateTime        @default(now())

  @@unique([destinationId, voterEmail])
}

model VoteComment {
  id            String          @id @default(cuid())
  destinationId String
  destination   VoteDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  userName      String
  userEmail     String
  comment       String
  createdAt     DateTime        @default(now())

  @@index([destinationId])
}

model Notification {
  id        String   @id @default(cuid())
  email     String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([read])
}

model CrewMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  image       String
  contact     String?
  instagram   String?
  description String?
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // Can store JSON string for complex objects
  category  String   @default("general") // e.g., 'hero', 'theme', 'seo'
  updatedAt DateTime @updatedAt
}

model MarketplaceListing {
  id          String   @id @default(cuid())
  category    String   // 'RESORT', 'CAR_RENTAL', 'VILLA', 'HOTEL', 'ROOM', 'ADVENTURE', 'TOUR_GUIDE', 'BIKE_RENTAL', 'HOMESTAY', 'LUXURY_STAY', 'TRAVEL_PACKAGE', 'CRUISE', 'EVENT'
  title       String
  description String
  price       Float
  priceUnit   String   // e.g., 'per night', 'per day', 'per person', 'total'
  location    String
  coverImage  String
  gallery     String   @default("[]") // JSON string of URLs
  amenities   String   @default("[]") // JSON string of features
  rating      Float    @default(5.0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Visitor {
  id        String   @id @default(cuid())
  visitorId String   @unique
  createdAt DateTime @default(now())
  sessions  VisitorSession[]
}

model VisitorSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  visitorId String
  visitor   Visitor  @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  ipAddress String?
  country   String?
  state     String?
  city      String?
  device    String?  // Mobile / Desktop / Tablet
  browser   String?
  os        String?
  referrer  String?
  startedAt DateTime @default(now())
  endedAt   DateTime @default(now())

  pageViews PageView[]

  @@index([startedAt])
  @@index([visitorId])
}

model PageView {
  id        String         @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  page      String
  visitedAt DateTime       @default(now())

  @@index([sessionId])
  @@index([visitedAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipient String   // Phone number or email
  provider  String   // 'Twilio', 'MSG91', etc.
  message   String
  status    String   // 'PENDING', 'SENT', 'FAILED'
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

model UpdateVideo {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  fileSize     Int?
  duration     Int?
  status       String   @default("PUBLISHED")
  category     String?
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("UpdateVideos")
}

model WhatsAppSettings {
  id              String   @id @default(cuid())
  messageTitle    String   @default("Booking Confirmation")
  messageTemplate String   @db.Text
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminLog {
  id          String   @id @default(cuid())
  adminName   String
  action      String
  details     String?
  createdAt   DateTime @default(now())
}

model InstagramMedia {
  id           String   @id @default(cuid())
  instagramId  String   @unique
  mediaType    String   // 'IMAGE', 'VIDEO', 'CAROUSEL_ALBUM'
  mediaUrl     String   @db.Text
  permalink    String   @db.Text
  thumbnailUrl String?  @db.Text
  caption      String?  @db.Text
  timestamp    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("InstagramMedia")
}
